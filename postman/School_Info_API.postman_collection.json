{
	"info": {
		"_postman_id": "school-info-api-collection",
		"name": "School Info API",
		"description": "CRUD API for School Info (one-to-one with School). Fields: admission_path, vision, mission, about_us. Access: Super Admin, Admin, and School roles.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000"
		},
		{
			"key": "access_token",
			"value": ""
		},
		{
			"key": "school_id",
			"value": ""
		},
		{
			"key": "school_info_id",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login (School / Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    if (json.access_token) {",
									"        pm.collectionVariables.set('access_token', json.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"your_school_or_admin_email@example.com\",\n  \"password\": \"your_password\",\n  \"login_type\": \"business\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login/",
							"host": ["{{base_url}}"],
							"path": ["auth", "login", ""]
						},
						"description": "Login to get access_token. Use school or admin credentials. For school users, login_type can be 'business' or 'listing'. Saves access_token to collection variable for other requests."
					}
				}
			]
		},
		{
			"name": "School Info",
			"item": [
				{
					"name": "Create School Info",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const json = pm.response.json();",
									"    if (json.id) pm.collectionVariables.set('school_info_id', json.id);",
									"    if (json.school_id) pm.collectionVariables.set('school_id', json.school_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"admission_path\": \"Fill application form, submit documents, pay fee.\",\n  \"vision\": \"To be a leading institution in quality education.\",\n  \"mission\": \"To nurture students with values and knowledge.\",\n  \"about_us\": \"We are a school established in 1990, offering classes 1-12.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/school/school-info/?school_id={{school_id}}",
							"host": ["{{base_url}}"],
							"path": ["school", "school-info", ""],
							"query": [
								{
									"key": "school_id",
									"value": "{{school_id}}",
									"description": "Required for Admin/Super Admin; omit for School user (uses own school)"
								}
							]
						},
						"description": "Create school info for a school. **School user**: do not send school_id (uses own school). **Admin/Super Admin**: send school_id in query or in body."
					}
				},
				{
					"name": "List School Info",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/school/school-info/?school_id={{school_id}}",
							"host": ["{{base_url}}"],
							"path": ["school", "school-info", ""],
							"query": [
								{
									"key": "school_id",
									"value": "{{school_id}}",
									"description": "Optional. Admin: filter by school; School user: ignored (returns own only)"
								}
							]
						},
						"description": "List school info. School user gets only their record; Admin gets all or filtered by school_id."
					}
				},
				{
					"name": "Get School Info by School ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/school/school-info/by-school/{{school_id}}/",
							"host": ["{{base_url}}"],
							"path": ["school", "school-info", "by-school", "{{school_id}}", ""]
						},
						"description": "Get school info by school_id. School user can only request their own school_id."
					}
				},
				{
					"name": "Get School Info by ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/school/school-info/{{school_info_id}}/",
							"host": ["{{base_url}}"],
							"path": ["school", "school-info", "{{school_info_id}}", ""]
						},
						"description": "Get a single school info record by its primary key (id)."
					}
				},
				{
					"name": "Update School Info",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"admission_path\": \"Updated admission steps.\",\n  \"vision\": \"Updated vision.\",\n  \"mission\": \"Updated mission.\",\n  \"about_us\": \"Updated about us.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/school/school-info/{{school_info_id}}/",
							"host": ["{{base_url}}"],
							"path": ["school", "school-info", "{{school_info_id}}", ""]
						},
						"description": "Update school info by id. Send only fields you want to change (partial update)."
					}
				},
				{
					"name": "Delete School Info",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{base_url}}/school/school-info/{{school_info_id}}/",
							"host": ["{{base_url}}"],
							"path": ["school", "school-info", "{{school_info_id}}", ""]
						},
						"description": "Delete school info by id. Returns 204 No Content on success."
					}
				}
			]
		}
	]
}
